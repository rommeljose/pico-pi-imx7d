diff --git a/examples/imx7d_pico_m4/demo_apps/instrumento/prueba_host.c b/examples/imx7d_pico_m4/demo_apps/instrumento/prueba_host.c
new file mode 100644
index 0000000..7f97fcb
--- /dev/null
+++ b/examples/imx7d_pico_m4/demo_apps/instrumento/prueba_host.c
@@ -0,0 +1,87 @@
+/* Prueba en el PC del generador y del detector de instrumento.c.
+ *   cc -O2 -DPRUEBA_HOST -o /tmp/prueba prueba_host.c -lm && /tmp/prueba
+ * Comprueba: (1) sin sismos no hay falsos disparos; (2) con sismos
+ * automáticos, cada sismo genera un evento; (3) a 10, 100 y 250 SPS. */
+#include "instrumento.c"
+
+static int led_estado, cambios_led;
+static void led(int e) { if (e != led_estado) cambios_led++; led_estado = e; }
+static int ini_ev, fin_ev; static long dur_total; static float pico_max;
+static int xQueueSend(QueueHandle_t q, const void *pm, int espera)
+{
+    const msg_t *m = pm; (void)q; (void)espera;
+    if (m->tipo == M_EVENTO_INI) ini_ev++;
+    if (m->tipo == M_EVENTO_FIN) { fin_ev++; dur_total += m->v[0]; if (m->v[1] > pico_max) pico_max = m->v[1]; }
+    return pdPASS;
+}
+
+static float max_err_seno(void)
+{
+    float e = 0, x;
+    for (x = -200.0f; x < 200.0f; x += 0.001f) {
+        float d = fabsf(seno(x) - (float)sin(x));
+        if (d > e) e = d;
+    }
+    return e;
+}
+
+static int corre(int fs, int segundos, int automatico, int32_t ruido)
+{
+    uint32_t n, N = (uint32_t)fs * segundos;
+    memset(&det, 0, sizeof det); memset(&sismo, 0, sizeof sismo);
+    est_eventos = est_sismos = 0; ini_ev = fin_ev = 0; dur_total = 0; pico_max = 0;
+    par.fs = fs; par.automatico = automatico; par.ruido = ruido; par.transmitir = 1;
+    detector_reinicia(fs);
+    proximo_auto = 15 * fs;
+    for (n = 0; n < N; n++) detecta(genera(fs), n, fs);
+    printf("fs=%3d  %5d s  auto=%d ruido=%-4d  sismos=%-3u eventos=%-3u (ini %d, fin %d)  "
+           "dur media=%.1f s  pico=%.0f\n", fs, segundos, automatico, (int)ruido,
+           (unsigned)est_sismos, (unsigned)est_eventos, ini_ev, fin_ev,
+           fin_ev ? (double)dur_total / fin_ev / fs : 0.0, pico_max);
+    return 0;
+}
+
+/* Notch de red: ganancia (dB) de un seno de f Hz muestreado a fs, en régimen.
+ * El filtro se diseña para la tasa fs_diseno (la «real» medida).           */
+static double ganancia_notch(int32_t red, float fs, float fs_diseno, float f)
+{
+    double e_in = 0, e_out = 0;
+    int i, N = (int)(fs * 60);
+    notch_prepara(red, fs_diseno, 1);
+    for (i = 0; i < N; i++) {
+        float x = 1000.0f * (float)sin(2 * M_PI * f * i / fs), y = notch_aplica(x);
+        if (i > N / 2) { e_in += (double)x * x; e_out += (double)y * y; }
+    }
+    return 10 * log10(e_out / e_in);
+}
+
+static void prueba_notch(void)
+{
+    static const float tasas[] = { 45, 88.8f, 90, 175, 330, 600, 100, 250 };
+    unsigned i;
+    printf("notch 60 Hz: tasa → centro, red, 1 Hz, 10 Hz, centro±1 Hz (dB)\n");
+    for (i = 0; i < sizeof tasas / sizeof tasas[0]; i++) {
+        float fs = tasas[i], fc = notch_prepara(60, fs, 1);
+        double r = ganancia_notch(60, fs, fs, 60.0f);   /* la red de verdad, plegada */
+        printf("  %6.1f SPS → %6.2f Hz  red %6.1f  1 Hz %5.2f  10 Hz %5.2f  ±1 Hz %5.1f/%5.1f\n",
+               fs, fc, r, ganancia_notch(60, fs, fs, 1.0f),
+               ganancia_notch(60, fs, fs, 10.0f),
+               ganancia_notch(60, fs, fs, fc - 1.0f), ganancia_notch(60, fs, fs, fc + 1.0f));
+    }
+    printf("  diseñado a 90 SPS nominal con el ADC a 88,8 reales: red %.1f dB\n",
+           ganancia_notch(60, 88.8f, 90.0f, 60.0f));
+    printf("  20 SPS: centro %.2f Hz (0 = sin notch: lo hace el ADS1220)\n",
+           notch_prepara(60, 20.0f, 1));
+}
+
+int main(void)
+{
+    prueba_notch();
+    printf("error máximo de seno() en [-200, 200] rad: %.2e\n", max_err_seno());
+    corre(100, 3600, 0, 20);     /* una hora de ruido: falsos disparos */
+    corre(100, 3600, 1, 20);
+    corre(10,  3600, 1, 20);
+    corre(250, 3600, 1, 20);
+    corre(100, 3600, 1, 200);    /* ruido 10 veces mayor */
+    return 0;
+}
